# Copy to .env.local (gitignored) after creating a Firebase web app.
# GitHub Pages: add the same keys as repository Secrets so deploy.yml can bake them in.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to 1 only when talking to the local Auth + Storage emulators.
# VITE_FIREBASE_EMULATOR=1
